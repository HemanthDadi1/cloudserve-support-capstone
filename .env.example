# Copy this file to .env and fill in your own values.
# Add .env to .gitignore before you put a real key in it.

OPENROUTER_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
MODEL_NAME=groq:qwen/qwen3.8-27b
MODEL_FALLBACKS=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,nvidia/nemotron-3.5-super-vl:free,recursive/flint-v1.0:free,xingchen-agi/xing4.0-29b-a4b:free
EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db

LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.85
INTENT_MIN_CONFIDENCE=0.50
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.40
